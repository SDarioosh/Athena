# Copy to server/.env (gitignored) and fill in. Never commit the real file.

# Shared token for all devices/side services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONVO_INGEST_TOKEN=change-me-generate-a-long-random-token

CONVO_DATA_DIR=data
# Bind to 0.0.0.0 only if devices reach the server over LAN/Tailscale.
CONVO_HOST=127.0.0.1
CONVO_PORT=8000

# Tell the device to stop after this much trailing silence (seconds).
CONVO_SILENCE_STOP_SECONDS=300
CONVO_MAX_SESSION_SECONDS=14400
CONVO_SESSION_IDLE_SECONDS=600

CONVO_CONVERSATION_GAP_SECONDS=180
CONVO_KEEP_AUDIO=false
# Retention: delete transcripts (and kept audio) of conversations older than N days,
# keeping their summaries, facts and action items. 0 = keep forever (default).
CONVO_TRANSCRIPT_RETENTION_DAYS=0
CONVO_LANGUAGE=en

# Voice activity detection: only speech it finds is transcribed. Leave these as they are
# until eval/recognition.py on far-field audio shows a change helps
# (docs/omi-audio-quality.md §4.2).
# Silero speech threshold (0-1) and padding added around each speech span (ms; Omi: 300).
# CONVO_VAD_THRESHOLD=0.5
# CONVO_VAD_MIN_SILENCE_MS=500   # silence that ends a speech span
# CONVO_VAD_SPEECH_PAD_MS=30
# VAD scores a copy of each 30 s chunk gained toward this peak (at most MAX_GAIN times,
# never quieter), so quiet speakers across the room aren't dropped. 1 = off. The stored
# audio isn't changed.
# CONVO_VAD_AGC_MAX_GAIN=1
# CONVO_VAD_AGC_TARGET=0.8

# whisper.cpp — set ONE of these
CONVO_WHISPER_SERVER_URL=http://127.0.0.1:8178
# CONVO_WHISPER_CLI=/opt/whisper.cpp/build/bin/whisper-cli
# CONVO_WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo.bin
# Names of known speakers are sent to whisper so it spells them right (false = off).
# CONVO_WHISPER_PROMPT_NAMES=true
# Extra vocabulary for whisper. Measured worse on the AMI eval (broken timestamps, wrong
# speaker names); leave empty unless eval/recognition.py shows it helps.
# CONVO_WHISPER_PROMPT="Odysseus, Tailscale, Zepp, Kubernetes."
# Temperature fallback step when a decode looks wrong (0 turns the fallback off).
# CONVO_WHISPER_TEMPERATURE_INC=0.2
# Drop text whisper invents on noise: a segment that is only a stock phrase ("Thank you.",
# "Bye.", "Amen.") below this mean token log-probability, subtitle credits, and words or
# segments repeated more than CONVO_WHISPER_MAX_REPEATS times in a row (README).
# CONVO_WHISPER_DROP_HALLUCINATIONS=true
# CONVO_WHISPER_DROP_PHRASE_LOGPROB=-0.7
# CONVO_WHISPER_MAX_REPEATS=4
# How speech goes to whisper: VAD regions are padded, then packed into clips of up to
# this many seconds (whisper decodes 30 s windows; 0 = send every region alone, the old
# behaviour). Silence between regions in a clip is shortened to the gap setting.
# CONVO_WHISPER_WINDOW_SECONDS=28
# CONVO_WHISPER_PAD_SECONDS=0.25
# CONVO_WHISPER_WINDOW_GAP_SECONDS=1.0
# Add the last N words of the previous clip to the prompt (0 = off; measured worse).
# CONVO_WHISPER_CONTEXT_WORDS=0
# Decoding, sent with every request (whisper-server fields / whisper-cli flags). The
# defaults are what measured best in eval/recognition.py; see server/README.md.
# CONVO_WHISPER_BEAM_SIZE=-1            # >1 = beam search (slower, did not help)
# CONVO_WHISPER_BEST_OF=2
# CONVO_WHISPER_SUPPRESS_NON_SPEECH=true  # measured: -0.8 to -1.5 WER far-field
# CONVO_WHISPER_NO_SPEECH_THOLD=0.6
# CONVO_WHISPER_LOGPROB_THOLD=-1.0
# CONVO_WHISPER_ENTROPY_THOLD=2.4
# CONVO_WHISPER_CARRY_INITIAL_PROMPT=false
# Gain each clip sent to whisper toward a 0.8 peak (at most this many times), only when
# its peak is at or below 0.4 of full scale. 1 = off; speaker matching never hears it
# (docs/omi-audio-quality.md §4.3).
# CONVO_ASR_AGC_MAX_GAIN=1

# Speech-to-text model: whisper (default, settings above) or parakeet (NVIDIA Parakeet
# TDT 0.6B v3, int8 ONNX, in-process on CPU; extra `parakeet`). Being measured against
# whisper on eval/recognition.py; keep whisper until the eval says otherwise
# (docs/omi-audio-quality.md §4.4). No prompt: CONVO_WHISPER_PROMPT* don't apply.
# Model (~490 MB download): sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8.tar.bz2 from
# https://github.com/k2-fsa/sherpa-onnx/releases/tag/asr-models, unpacked.
# CONVO_TRANSCRIBER=parakeet
# CONVO_PARAKEET_MODEL_DIR=/opt/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
# CONVO_PARAKEET_THREADS=4
# Parakeet sometimes goes silent for a stretch of real speech inside a chunk. true =
# decode each such hole (≥ 1 s of speech energy, no tokens) again and merge the words
# in; costs extra decode time only where holes occur. Off until measured on the eval.
# CONVO_PARAKEET_REDECODE_HOLES=false

# llama-server (OpenAI-compatible). Must be on this machine / your LAN.
CONVO_LLM_BASE_URL=http://127.0.0.1:8082/v1
CONVO_LLM_MODEL=qwen3.5-35b
# The worker retries a failed summary once its last attempt is this old (seconds).
# CONVO_SUMMARY_RETRY_SECONDS=300

# Optional embeddings server (llama-server --embeddings with e.g. bge-m3 / nomic-embed)
# CONVO_EMBED_BASE_URL=http://127.0.0.1:8083/v1
# CONVO_EMBED_MODEL=bge-m3

CONVO_DIARIZATION=true
# ecapa (default) or pyannote (extra `pyannote`; local community-1 pipeline, see README)
# CONVO_DIARIZER=pyannote
# CONVO_PYANNOTE_DEVICE=auto
# Rename unnamed speakers in other conversations when a named voice matches this well.
# CONVO_SPEAKER_RELABEL_THRESHOLD=0.60
# A one-line speaker joins the closest speaker when the voice is this similar (0 = off).
# CONVO_SPEAKER_ABSORB_THRESHOLD=0.30
# The loudest voice is the owner when it is a borderline match (0 margin = off).
# CONVO_OWNER_HINT_MARGIN=0.10
# CONVO_OWNER_HINT_DB=3.0
# With CONVO_DIARIZER=pyannote these are on by default (README "Fewer wrong names with
# pyannote"); set them to go back: CONVO_SPEAKER_SPLIT_LINES=false,
# CONVO_SPEAKER_LINE_CHECK=false, CONVO_VAD_THRESHOLD=0.5 (pyannote default 0.35).
# CONVO_SPEAKER_SPLIT_MIN_SECONDS=0.3
# Opt-in: keep more speakers apart (newcomers get "Speaker N" instead of an existing
# name, at the cost of more unnamed lines)
# CONVO_PYANNOTE_VBX_FB=0.2
CONVO_OWNER_NAME=Me
CONVO_TIMEZONE=UTC
# To-do lists left out of the daily digest (comma list, any case).
# CONVO_DIGEST_SKIP_LISTS=Shopping,Groceries,Grocery

# Knowledge layer: base URL for transcript links (use the address your phone reaches,
# e.g. the Tailscale IP). Defaults to http://CONVO_HOST:CONVO_PORT.
# CONVO_PUBLIC_URL=http://100.64.0.10:8000

# MCP over HTTP only (`convo-server mcp --http`, e.g. for Odysseus in Docker). stdio
# (`convo-server mcp`, e.g. Hermes) ignores these. HTTP refuses to start without a
# token of >= 16 chars; generate one as above, separate from CONVO_INGEST_TOKEN.
# Set the host to the docker bridge IP (e.g. 172.17.0.1) if Odysseus runs in Docker.
# CONVO_MCP_TOKEN=change-me-generate-another-long-random-token
# CONVO_MCP_HOST=127.0.0.1
# CONVO_MCP_PORT=8001
# A fact counts as confirmed (MCP list_facts confirmed=true, copied into the hub's
# memory) once it was said in this many distinct conversations on this many distinct
# days (CONVO_TIMEZONE) and nothing newer replaced it.
# CONVO_FACT_CONFIRM_SOURCES=3
# CONVO_FACT_CONFIRM_DAYS=2

# server/scripts/deploy.sh (one-command update + background services). All optional.
# whisper-server as a service too: the full command line, absolute path first.
# BARVIS_SOUND_WHISPER_CMD=/opt/whisper.cpp/build/bin/whisper-server -m /opt/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin --host 127.0.0.1 --port 8178
# BARVIS_SOUND_BRANCH=main
# BARVIS_SOUND_REMOTE=origin
# BARVIS_SOUND_EXTRAS=vad,diarization
# systemd, background or auto:
# BARVIS_SOUND_RUNNER=auto
# After a deploy, update Odysseus too with its scripts/fork_deploy.sh. Default: the checkout
# of the running Odysseus container (needs docker; asks for sudo). off = never.
# BARVIS_SOUND_ODYSSEUS_DIR=/path/to/odysseus
