# Copy to server/.env (gitignored) and fill in. Never commit the real file.

# Shared token for all devices/side services. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONVO_INGEST_TOKEN=change-me-generate-a-long-random-token

CONVO_DATA_DIR=data
# Bind to 0.0.0.0 only if devices reach the server over LAN/Tailscale.
CONVO_HOST=127.0.0.1
CONVO_PORT=8000

# Tell the device to stop after this much trailing silence (seconds).
CONVO_SILENCE_STOP_SECONDS=300
CONVO_MAX_SESSION_SECONDS=14400
CONVO_SESSION_IDLE_SECONDS=600

CONVO_CONVERSATION_GAP_SECONDS=180
CONVO_KEEP_AUDIO=false
CONVO_LANGUAGE=en

# whisper.cpp — set ONE of these
CONVO_WHISPER_SERVER_URL=http://127.0.0.1:8178
# CONVO_WHISPER_CLI=/opt/whisper.cpp/build/bin/whisper-cli
# CONVO_WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo.bin
# Vocabulary whisper should spell right; names of known speakers are added automatically.
# CONVO_WHISPER_PROMPT="Barvis, Tailscale, Zepp, Kubernetes."
# Temperature fallback step when a decode looks wrong (0 turns the fallback off).
# CONVO_WHISPER_TEMPERATURE_INC=0.2

# llama-server (OpenAI-compatible). Must be on this machine / your LAN.
CONVO_LLM_BASE_URL=http://127.0.0.1:8082/v1
CONVO_LLM_MODEL=qwen3.5-35b
# The worker retries a failed summary once its last attempt is this old (seconds).
# CONVO_SUMMARY_RETRY_SECONDS=300

# Optional embeddings server (llama-server --embeddings with e.g. bge-m3 / nomic-embed)
# CONVO_EMBED_BASE_URL=http://127.0.0.1:8083/v1
# CONVO_EMBED_MODEL=bge-m3

CONVO_DIARIZATION=true
CONVO_OWNER_NAME=Me
CONVO_TIMEZONE=UTC

# Knowledge layer: base URL for transcript links (use the address your phone reaches,
# e.g. the Tailscale IP). Defaults to http://CONVO_HOST:CONVO_PORT.
# CONVO_PUBLIC_URL=http://100.64.0.10:8000

# MCP over HTTP only (`convo-server mcp --http`, e.g. for Odysseus in Docker). stdio
# (`convo-server mcp`, e.g. Hermes) ignores these. HTTP refuses to start without a
# token of >= 16 chars; generate one as above, separate from CONVO_INGEST_TOKEN.
# Set the host to the docker bridge IP (e.g. 172.17.0.1) if Odysseus runs in Docker.
# CONVO_MCP_TOKEN=change-me-generate-another-long-random-token
# CONVO_MCP_HOST=127.0.0.1
# CONVO_MCP_PORT=8001
