# embed_file(<c symbol> <input file> <output .c>): a C file defining
#   const unsigned char <sym>[]; const unsigned long <sym>_len;
# Regenerated at configure time when the input changes.
function(embed_file sym in out)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${in}")
    file(READ "${in}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
    file(WRITE "${out}.tmp"
        "/* Generated by cmake/embed_file.cmake from ${in}. */\n"
        "const unsigned char ${sym}[] = {\n${hex}\n};\n"
        "const unsigned long ${sym}_len = ${bytes}UL;\n")
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out}.tmp")
endfunction()
