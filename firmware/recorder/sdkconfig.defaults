# Shared defaults for every board. Board-specific settings (PSRAM mode, flash size, CPU
# frequency) live in sdkconfig.<board>. Build with both:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.twatch_ultra" build
CONFIG_IDF_TARGET="esp32s3"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Power management: DFS now, light sleep is a milestone-2 question
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Console on the native USB (Serial/JTAG). No secondary UART console: UART0's pins
# (GPIO43/44) go to the GPS on the T-Watch Ultra.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=n

# Radios: BLE only, NimBLE host (main/ble_sync.c, docs/twatch-ble-protocol.md). Wi-Fi is
# never initialised and not linked (CMakeLists.txt builds only what main pulls in).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Peripheral / GATT server only: the relay is the central.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
# One relay at a time: one connection, plus one advertising set in the controller.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# ATT MTU up to 517: a DATA frame then carries 505 bytes.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# BLE 5: 2M PHY for the transfer burst. Coded PHY and extended advertising aren't used
# (legacy advertising keeps the relay's scan filter simple).
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY=n
CONFIG_BT_NIMBLE_EXT_ADV=n
# Pairing (§3.1): LE Secure Connections only (legacy pairing compiled out), passkey shown
# on the watch screen (MITM-protected), bonds kept in NVS, at most 4.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=8
# Notification bursts: room for a few 514-byte frames in flight (each spans 3 blocks).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# The controller sleeps between radio events and lets DFS drop the CPU clock; without
# this it holds the APB clock at max for as long as BT is enabled. Main crystal as the
# sleep clock: the only source that works with DFS without an external 32 kHz crystal,
# and none is known to be wired to the ESP32-S3 on the T-Watch Ultra.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
# TX power: the controller default (+9 dBm). Lower it after milestone 2 measures range.

# FAT on the SD card: long file names
CONFIG_FATFS_LFN_HEAP=y

# Task watchdog: the session and BLE tasks are subscribed (and both idle tasks). A task
# that doesn't feed it for 10 s panics: core dump, restart, reset=task_wdt, and a
# conversation that was recording starts again after the boot.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Core dump of a crash to the `coredump` partition (console `coredump`, tools/pull.py
# --coredump; decode with `idf.py coredump-info -c <file>`). ELF: task stacks and TCBs only.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
# Its own debug logs: noisy on the console, and ~5 KB of DRAM.
CONFIG_ESP_COREDUMP_LOGS=n

# C library: keep printf small but with 64-bit support for the SD size
CONFIG_NEWLIB_NANO_FORMAT=n
