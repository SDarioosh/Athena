# LilyGO T4-S3: ESP32-S3R8 (8 MB octal PSRAM in the package), 16 MB flash; recordings go to
# a FAT partition in flash (the microSD slot isn't used yet).
# Build with: idf.py -B build-t4 -DBOARD=t4_s3 -DSDKCONFIG=build-t4/sdkconfig
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.t4_s3" build
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Same 16 MB layout as the T-Watch S3: the queue lives in "storage" (FAT, wear levelling).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_twatch_s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_twatch_s3.csv"
CONFIG_WL_SECTOR_SIZE_4096=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# 80 MHz, as the watches: DFS goes 80 <-> 40. Four mics mixed to mono plus Opus fit (the
# mixer is a few adds per sample).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# A crash reboots rather than hanging.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# The I2S interrupt keeps running while flash is written (caches off). Without it, DMA
# buffers that finish during a flash write are lost silently: measured 2026-10-21, 20.7 s of
# audio in 21.8 s of recording into the flash queue; with it, none lost (main/mic.c).
CONFIG_I2S_ISR_IRAM_SAFE=y
