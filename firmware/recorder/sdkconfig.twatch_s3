# LilyGO T-Watch S3: ESP32-S3R8 (8 MB octal PSRAM in the package), 16 MB flash, no SD card.
# Build with: idf.py -B build-s3 -DBOARD=twatch_s3 -DSDKCONFIG=build-s3/sdkconfig
#   -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.twatch_s3" build
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Storage is a FAT partition in flash (partitions_twatch_s3.csv).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_twatch_s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_twatch_s3.csv"
CONFIG_WL_SECTOR_SIZE_4096=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# 80 MHz, as the Ultra: DFS goes 80 <-> 40.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# A crash reboots rather than hanging.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
