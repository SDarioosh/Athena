<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Heading"
            android:text="@string/state_heading" />

        <TextView
            android:id="@+id/phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Medium" />

        <TextView
            android:id="@+id/permission_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/permission_note"
            android:textColor="#B3261E"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="?android:attr/buttonBarStyle"
            android:orientation="horizontal">

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_relay" />

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/open_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_exemption"
            android:visibility="gone" />

        <TextView
            style="@style/Heading"
            android:text="@string/watch_heading" />

        <TextView
            android:id="@+id/watch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Heading"
            android:text="@string/pda_heading" />

        <TextView
            android:id="@+id/pda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/pda_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pda_sync_now" />

        <TextView
            style="@style/Heading"
            android:text="@string/uploads_heading" />

        <TextView
            android:id="@+id/counters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Heading"
            android:text="@string/error_heading" />

        <TextView
            android:id="@+id/last_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            style="@style/Heading"
            android:text="@string/log_heading" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
