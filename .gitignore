# secrets
.env
secrets.h
firmware-archive/

# build output / environments
.pio/
# ESP-IDF (firmware/recorder): keep sdkconfig.defaults and sdkconfig.<board>, not the
# generated sdkconfig, build dirs or downloaded components
firmware/**/build/
firmware/**/build-*/
/build-host/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
node_modules/

# server runtime data (database, queued audio, downloaded models)
server/data/

# never commit audio
*.opus
*.wav
*.ogg
*.oga
*.mp3
*.m4a
*.aac
*.flac
*.webm
*.pcm

# logs
*.log

# Zoom Meeting SDK (proprietary): never commit it. The owner keeps it outside the repo;
# these catch a copy dropped into meeting-bot/ by mistake.
meeting-bot/**/zoom-sdk/
meeting-bot/**/zoomsdk/
meeting-bot/**/zoom-meeting-sdk*/
meeting-bot/**/*.so
meeting-bot/**/*.so.*
meeting-bot/**/libmeetingsdk*
meeting-bot/**/qt_libs/
meeting-bot/**/*.tar.xz
meeting-bot/**/*.tar.gz
meeting-bot/**/*.whl
# spike build and run output
meeting-bot/**/build/
meeting-bot/**/out/
meeting-bot/**/results/

# meeting bot build dir (meeting-bot/core/README.md)
/build-bot/
